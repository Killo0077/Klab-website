---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---
<header class="site-header" id="site-header">
  <div class="site-header-inner kac-wrap">
    <a href="/" class="site-logo" aria-label="Kacerys — Home">
      <svg aria-hidden="true" viewBox="0 0 48 48" fill="none" width="38" height="38">
        <path d="M24 3 43 14v20L24 45 5 34V14L24 3Z" stroke="currentColor" stroke-width="2.4"/>
        <path d="M24 12 35 18.5v11L24 36l-11-6.5v-11L24 12Z" stroke="currentColor" stroke-width="2"/>
        <path d="m5 14 19 11 19-11M24 25v20" stroke="currentColor" stroke-width="2"/>
      </svg>
      <span class="site-wordmark"><strong>KACERYS</strong><small>DESIGN · PRINT · IMPROVE</small></span>
    </a>
    <nav class="site-navigation" id="site-navigation" aria-label="Main navigation">
      {navItems.map(item => (
        <a href={item.href} class:list={["site-nav-link", { "is-active": currentPath === item.href }]} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>
      ))}
      <a href="/projects" class="site-mobile-projects">Explore projects <span aria-hidden="true">→</span></a>
    </nav>
    <a href="/projects" class="site-header-cta">Explore projects <span aria-hidden="true">↗</span></a>
    <button type="button" class="site-menu-button" id="site-menu-button" aria-controls="site-navigation" aria-expanded="false" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<script>
  const menuButton = document.querySelector<HTMLButtonElement>("#site-menu-button");
  const navigation = document.querySelector<HTMLElement>("#site-navigation");
  const siteHeader = document.querySelector<HTMLElement>("#site-header");
  menuButton?.addEventListener("click", () => {
    const isOpen = navigation?.classList.toggle("is-open") ?? false;
    menuButton.setAttribute("aria-expanded", String(isOpen));
    menuButton.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });
  navigation?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
    navigation.classList.remove("is-open");
    menuButton?.setAttribute("aria-expanded", "false");
  }));
  const checkScroll = () => siteHeader?.classList.toggle("is-scrolled", window.scrollY > 18);
  window.addEventListener("scroll", checkScroll, { passive: true });
  checkScroll();
</script>
