<button class="back-to-top" type="button" id="back-to-top" aria-label="Back to top" title="Back to top">
  <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 14 6-6 6 6"/></svg>
</button>
<script>
  const backButton = document.querySelector<HTMLButtonElement>("#back-to-top");
  const toggleBackButton = () => backButton?.classList.toggle("is-visible", window.scrollY > 480);
  window.addEventListener("scroll", toggleBackButton, { passive: true });
  backButton?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  });
  toggleBackButton();
</script>
