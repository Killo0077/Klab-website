---
import ProductLayout from "../layouts/ProductLayout.astro";
---

<ProductLayout
    title="Hanging Bird Feeder | Kacerys"
    productName="Hanging Bird Feeder"
    price="€19.99"
>
    <!-- IMAGES -->
    <div slot="images">
        <img
            id="main-img"
            class="product-img-main"
            src="/assets/hanginig-feeder/1.png"
            alt="Hanging Bird Feeder"
        />

        <div class="thumb-grid">
            <img
                class="thumb"
                src="/assets/hanginig-feeder/3.png"
                alt="Hanging Bird Feeder view"
                onclick="swapImg(this)"
            />

            <img
                class="thumb"
                src="/assets/hanginig-feeder/2.png"
                alt="Hanging Bird Feeder view"
                onclick="swapImg(this)"
            />

            <img
                class="thumb active"
                src="/assets/hanginig-feeder/1.png"
                alt="Hanging Bird Feeder"
                onclick="swapImg(this)"
            />
        </div>
    </div>

    <!-- TAGS -->
    <div slot="tags">
        <span class="tag tag-outdoor">Outdoor</span>
        <span class="tag tag-garden">Garden</span>
        <span class="tag tag-3dprinted">3D Printed</span>
    </div>

    <!-- DETAILS -->
    <div slot="details" class="flex flex-col gap-6">
        <p class="text-gray-400 text-sm">Price excludes shipping</p>

        <p class="text-gray-300 leading-relaxed">
            A simple and durable hanging bird feeder designed for year-round
            outdoor use. The elevated feeding tray provides easy access for
            garden birds while keeping seed contained and visible.
        </p>

        <p class="text-gray-300 leading-relaxed">
            Lightweight, weather-resistant and easy to hang from trees, hooks or
            garden structures.
        </p>

        <!-- SPECIFICATIONS -->
        <div class="product-card">
            <p class="section-title">Specifications</p>

            <div class="spec-row">
                <span class="spec-label">Material</span>
                <span class="spec-value">PETG</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Outer Diameter</span>
                <span class="spec-value">180 mm</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Feeder Diameter</span>
                <span class="spec-value">125 mm</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Weight</span>
                <span class="spec-value">Approx. 100 g</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Colour</span>
                <span class="spec-value">Custom colours available</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Weather Resistant</span>
                <span class="spec-value">Yes</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Assembly Required</span>
                <span class="spec-value">No</span>
            </div>
        </div>

        <!-- BUY -->
        <a
            href="https://www.etsy.com/ie/listing/4525043333/hanging-bird-feeder-3d-printed-outdoor"
            target="_blank"
            rel="noopener noreferrer"
            class="buy-btn"
        >
            Buy on Etsy
        </a>

        <a
            href="/contact"
            style="color:#00D4FF; font-size:0.85rem; text-align:center; text-decoration:none;"
        >
            Need a custom size or colour?
            <strong>Get in touch →</strong>
        </a>
    </div>

    <!-- BOTTOM -->
    <div slot="bottom" class="mt-12 flex flex-wrap gap-10 justify-center">
        <!-- ABOUT -->
        <div class="w-full md:w-1/2">
            <p class="section-title">About This Product</p>

            <div class="text-gray-300 leading-relaxed flex flex-col gap-4">
                <p>
                    The Hanging Bird Feeder was designed as a simple,
                    lightweight feeding station for garden birds. Its open
                    design allows birds to approach the feeding tray easily
                    while keeping the seed visible and accessible.
                </p>

                <p>
                    Printed in PETG, the feeder is suitable for outdoor use and
                    can withstand changing weather conditions better than
                    standard indoor printing materials.
                </p>

                <p>
                    The integrated hanging design makes installation simple:
                    attach it to a suitable cord or hook and position it from a
                    tree branch, garden structure or other secure support.
                </p>
            </div>
        </div>

        <!-- FEATURES -->
        <div class="w-full md:w-5/12">
            <p class="section-title">Features</p>

            <ul
                class="text-gray-300 flex flex-col gap-2"
                style="list-style:none; padding:0;"
            >
                <li>✓ Weather-resistant PETG construction</li>
                <li>✓ Lightweight design</li>
                <li>✓ No assembly required</li>
                <li>✓ Easy-access feeding tray</li>
                <li>✓ Suitable for year-round outdoor use</li>
                <li>✓ Custom colours available</li>
            </ul>

            <div style="margin-top: 2rem;">
                <p class="section-title">Shipping</p>

                <p class="text-gray-300 text-sm leading-relaxed">
                    Ships within 3–5 business days. Tracked delivery available.
                    Currently shipping to Ireland and UK.
                </p>
            </div>
        </div>
    </div>

    <!-- IMAGE GALLERY -->
    <script is:inline>
        function swapImg(thumb) {
            document.getElementById("main-img").src = thumb.src;

            document.querySelectorAll(".thumb").forEach(function (t) {
                t.classList.remove("active");
            });

            thumb.classList.add("active");
        }
    </script>
</ProductLayout>
