---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
const categories = ["3D Printed", "Garden", "Home", "Outdoor", "Repair", "IoT"];
const usedCategories = categories.filter((c) =>
    projects.some((p) => p.data.category.includes(c)),
);
const categorySlug = (label: string) => label.toLowerCase().replace(/\s+/g, "");
---

<Layout title="Projects | Kacerys">
    <Header />
    <main class="kac-catalogue">
        <section class="kac-catalogue-hero">
            <div class="kac-catalogue-orbit orbit-one" aria-hidden="true"></div>
            <div class="kac-catalogue-orbit orbit-two" aria-hidden="true"></div>
            <div class="kac-wrap kac-catalogue-intro">
                <p class="kac-eyebrow">Ideas / Designs / Solutions</p>
                <h1>Projects<span class="kac-dot">.</span></h1>
                <p>
                    Practical designs for the home, garden and everything in
                    between. Explore what we've made so far.
                </p>
            </div>
            <svg
                class="kac-section-wave catalogue-wave"
                viewBox="0 0 1440 75"
                preserveAspectRatio="none"
                aria-hidden="true"
                ><path
                    d="M0 30C258 77 326 -20 616 37C870 86 1055 -12 1440 43V75H0Z"
                    fill="#071623"></path><path
                    d="M0 30C258 77 326 -20 616 37C870 86 1055 -12 1440 43"
                    fill="none"
                    stroke="#126e94"
                    stroke-width="1.2"></path></svg
            >
        </section>
        <section
            class="kac-wrap kac-project-section"
            aria-labelledby="catalogue-heading"
        >
            <div class="kac-catalogue-toolbar">
                <div>
                    <h2 id="catalogue-heading">Explore the collection</h2>
                    <p id="project-count" class="kac-count" aria-live="polite">
                        {projects.length} projects
                    </p>
                </div>
                <label class="kac-project-search">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        ><circle cx="10.8" cy="10.8" r="7"></circle><path
                            d="m16 16 5 5"></path></svg
                    >
                    <span class="sr-only">Search projects</span>
                    <input
                        id="project-search"
                        type="search"
                        placeholder="Search projects..."
                        autocomplete="off"
                    />
                </label>
            </div>
            <div
                class="kac-filter-list"
                role="group"
                aria-label="Filter projects"
            >
                <button
                    type="button"
                    class="filter-btn active"
                    data-filter="all"
                    aria-pressed="true">All</button
                >
                {
                    usedCategories.map((category) => (
                        <button
                            type="button"
                            class="filter-btn"
                            data-filter={categorySlug(category)}
                            aria-pressed="false"
                        >
                            {category}
                        </button>
                    ))
                }
            </div>
            <div class="project-grid catalogue-grid" id="project-grid">
                {projects.map((project) => <ProjectCard project={project} />)}
            </div>
            <div class="no-results" id="no-results" hidden>
                No projects match that search. Try another category or keyword.
            </div>
            <div class="kac-catalogue-bottom">
                <p>Have something in mind that isn't here yet?</p><a
                    href="/contact"
                    class="kac-text-link"
                    >Talk to us about a custom project <span aria-hidden="true"
                        >→</span
                    ></a>
            </div>
        </section>
    </main>
    <Footer />
    <script>
        const buttons = Array.from(
            document.querySelectorAll<HTMLButtonElement>(".filter-btn"),
        );
        const cards = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("#project-grid > a"),
        );
        const search =
            document.querySelector<HTMLInputElement>("#project-search");
        const count = document.querySelector<HTMLElement>("#project-count");
        const noResults = document.querySelector<HTMLElement>("#no-results");
        let currentFilter = "all";

        function filterCatalogue() {
            const term = (search?.value ?? "").trim().toLowerCase();
            let visible = 0;
            for (const link of cards) {
                const card = link.querySelector<HTMLElement>(".project-card");
                const categories = (card?.dataset.categories ?? "").split(" ");
                const text = link.textContent?.toLowerCase() ?? "";
                const matches =
                    (currentFilter === "all" ||
                        categories.includes(currentFilter)) &&
                    (!term || text.includes(term));
                link.style.display = matches ? "" : "none";
                if (matches) visible += 1;
            }
            if (count)
                count.textContent = `${visible} project${visible === 1 ? "" : "s"}`;
            if (noResults) noResults.hidden = visible !== 0;
        }
        function setFilter(next: string) {
            currentFilter = next;
            for (const button of buttons) {
                const active = button.dataset.filter === next;
                button.classList.toggle("active", active);
                button.setAttribute("aria-pressed", String(active));
            }
            filterCatalogue();
        }
        buttons.forEach((button) =>
            button.addEventListener("click", () => {
                setFilter(button.dataset.filter ?? "all");
                const url = new URL(window.location.href);
                if (currentFilter === "all")
                    url.searchParams.delete("category");
                else url.searchParams.set("category", currentFilter);
                history.replaceState(null, "", url);
            }),
        );
        search?.addEventListener("input", filterCatalogue);
        const requested = new URLSearchParams(location.search)
            .get("category")
            ?.toLowerCase();
        setFilter(
            requested && buttons.some((btn) => btn.dataset.filter === requested)
                ? requested
                : "all",
        );
    </script>
</Layout>
