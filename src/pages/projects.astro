---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Projects | Kacerys">
    <Header />
    <hr class="border-b border-gray-100 opacity-25 my-0 py-0" />

    <!-- Page Hero -->
    <div
        style="position: relative; min-height: 520px; background-color: #0D1117; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden;"
    >
        <img
            src="/assets/heroproject.v2.png"
            alt="Kacerys workshop"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; opacity: 0.8;"
        />

        <div
            style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,15,30,0.45) 0%, rgba(10,15,30,0.25) 50%, rgba(10,15,30,0.9) 100%);"
        >
        </div>

        <div style="position: relative; z-index: 1; padding: 8rem 1.5rem 4rem;">
            <p
                class="uppercase tracking-loose cyan-text brand-font text-sm mb-4"
            >
                DESIGN • ENGINEER • INNOVATE
            </p>

            <h1
                class="text-5xl font-bold leading-tight brand-font mb-4 text-white"
            >
                Projects
            </h1>

            <p class="text-xl text-gray-300 max-w-xl mx-auto">
                Everything built at Kacerys starts with a real problem. Here are
                the products developed so far.
            </p>
        </div>
    </div>

    <!-- Wave -->
    <div class="relative -mt-12 lg:-mt-24">
        <svg
            viewBox="0 0 1428 174"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
        >
            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                <g
                    transform="translate(-2.000000, 44.000000)"
                    fill="#1B2438"
                    fill-rule="nonzero"
                >
                    <path
                        d="M0,0 C90.7283404,0.927527913 147.912752,27.187927 291.910178,59.9119003 C387.908462,81.7278826 543.605069,89.334785 759,82.7326078 C469.336065,156.254352 216.336065,153.6679 0,74.9732496"
                        opacity="0.100000001"></path>

                    <path
                        d="M100,104.708498 C277.413333,72.2345949 426.147877,52.5246657 546.203633,45.5787101 C666.259389,38.6327546 810.524845,41.7979068 979,55.0741668 C931.069965,56.122511 810.303266,74.8455141 616.699903,111.243176 C423.096539,147.640838 250.863238,145.462612 100,104.708498 Z"
                        opacity="0.100000001"></path>

                    <path
                        d="M1046,51.6521276 C1130.83045,29.328812 1279.08318,17.607883 1439,40.1656806 L1439,120 C1271.17211,77.9435312 1140.17211,55.1609071 1046,51.6521276 Z"
                        opacity="0.200000003"></path>
                </g>

                <g
                    transform="translate(-4.000000, 76.000000)"
                    fill="#1B2438"
                    fill-rule="nonzero"
                >
                    <path
                        d="M0.457,34.035 C57.086,53.198 98.208,65.809 123.822,71.865 C181.454,85.495 234.295,90.29 272.033,93.459 C311.355,96.759 396.635,95.801 461.025,91.663 C486.76,90.01 518.727,86.372 556.926,80.752 C595.747,74.596 622.372,70.008 636.799,66.991 C663.913,61.324 712.501,49.503 727.605,46.128 C780.47,34.317 818.839,22.532 856.324,15.904 C922.689,4.169 955.676,2.522 1011.185,0.432 C1060.705,1.477 1097.39,3.129 1121.236,5.387 C1161.703,9.219 1208.621,17.821 1235.4,22.304 C1285.855,30.748 1354.351,47.432 1440.886,72.354 L1441.191,104.352 L1.121,104.031 L0.457,34.035 Z"
                    ></path>
                </g>
            </g>
        </svg>
    </div>

    <!-- Projects Section -->
    <section class="py-12" style="background-color: #1B2438;">
        <div class="container max-w-6xl mx-auto px-6">
            <!-- Filter Buttons -->
            <div class="flex flex-wrap justify-center gap-3 mb-6">
                <button class="filter-btn active" data-filter="all">All</button>
                <button class="filter-btn" data-filter="outdoor">Outdoor</button
                >
                <button class="filter-btn" data-filter="repair">Repair</button>
                <button class="filter-btn" data-filter="iot">IoT</button>
                <button class="filter-btn" data-filter="home">Home</button>
                <button class="filter-btn" data-filter="garden">Garden</button>
            </div>

            <!-- Project Count -->
            <p
                class="text-center text-gray-300 text-sm mb-8"
                id="project-count"
            >
            </p>

            <!-- PROJECT GRID -->
            <div class="project-grid" id="project-grid">
                <!-- Cyberpunk Hardware Box -->
                <a href="/cyberbox" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home repair 3dprinted outdoor"
                    >
                        <img
                            src="/assets/cyberpunk/orasakabox.png"
                            alt="Arasaka hardware box"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-repair">Repair</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-home">Home</span>
                                <span class="tag tag-outdoor">Outdoor</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Arasaka Hardware Box
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                This custom Arasaka-inspired hardware organizer
                                was designed and 3D printed to store small
                                electronic components, tools, screws, bolts and
                                other workshop hardware in a compact portable
                                case.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Bonsai Pot -->
                <a href="/bonsaiPot" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home repair 3dprinted outdoor"
                    >
                        <img
                            src="/assets/bonsaiPot/bonsai pot thumbnail.png"
                            alt="Bonsai inspired pot"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-home">Home</span>
                                <span class="tag tag-outdoor">Outdoor</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Bonsai-inspired Pot
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                The pot features Japanese-inspired detailing and
                                a smooth curved profile, while the surrounding
                                stand provides a stable base and gives the
                                design a more traditional ornamental appearance.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Bird Feeder -->
                <a href="/birdfeeder" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="outdoor 3dprinted garden"
                    >
                        <img
                            src="/assets/papiro-birdfeeder/1.png"
                            alt="Bird Feeder"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-outdoor">Outdoor</span>
                                <span class="tag tag-garden">Garden</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Bird Feeder
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                Designed for bird enthusiasts who value
                                functionality and durability. Easy refilling,
                                weather-resistant materials, and versatile
                                mounting options for gardens and patios.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Reading Glasses Case -->
                <a href="/readglassesCase" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="outdoor 3dprinted garden"
                    >
                        <img
                            src="/assets/readglassesCase/thumbnail.png"
                            alt="Reading Glasses Case"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-outdoor">Outdoor</span>
                                <span class="tag tag-garden">Garden</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Reading Glasses Case
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                A fully 3D-printed PLA glasses case featuring a
                                detailed floral design, textured exterior, and
                                protective internal liner.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Giant Pencil Sharpener -->
                <a href="/sacapuntas" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home repair 3dprinted"
                    >
                        <img
                            src="/assets/sacapuntas/imagen1.png"
                            alt="Giant Decorative Pencil Sharpener"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-home">Home</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Giant Decorative Pencil Sharpener
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                Designed for fun and creative spaces. A playful
                                oversized pencil sharpener decoration that adds
                                personality to desks, offices, and shelves.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Cyberpunk Sunglasses Case -->
                <a href="/sunglassesCase" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home repair 3dprinted outdoor"
                    >
                        <img
                            src="/assets/cyberpunk/sunglassescase.png"
                            alt="Cyberpunk-Inspired Sunglasses Case"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-repair">Repair</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-home">Home</span>
                                <span class="tag tag-outdoor">Outdoor</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Cyberpunk-Inspired Sunglasses Case
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                Rigid protective PLA shell with a flexible
                                internal liner, mechanical hinge system and
                                Cyberpunk-inspired exterior.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Henry Hoover Retaining Ring -->
                <a href="/retaining-ring" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home repair 3dprinted"
                    >
                        <img
                            src="/assets/Henry-Hoover/retainingRing.webp"
                            alt="Henry Hoover Retaining Ring"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-repair">Repair</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-home">Home</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Henry Hoover Hose Retaining Ring
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                A durable repair solution to restore broken hose
                                connections without replacing the entire
                                assembly. Engineered for a secure fit and easy
                                installation.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Custom Mailbox Sign -->
                <a href="/mailbox" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home repair 3dprinted outdoor"
                    >
                        <img
                            src="/assets/mailbox/mailbox1.png"
                            alt="Custom Mailbox Sign"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-repair">Repair</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-home">Home</span>
                                <span class="tag tag-outdoor">Outdoor</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Custom Mailbox Sign
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                Make your mailbox stand out with personalized
                                3D-printed lettering and decorative icons.
                                Create a unique entrance feature for your home.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Remote Controller Wall Mount -->
                <a href="/remote-wall-mount" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home iot 3dprinted"
                    >
                        <img
                            src="/assets/remote-wall/2.png"
                            alt="LED Remote Controller Wall Mount"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-iot">IoT</span>
                                <span class="tag tag-home">Home</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                LED Remote Controller Wall Mount
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                A compact 3D-printed wall mount designed to keep
                                LED remote controllers organised, accessible and
                                securely stored.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Hanging Bird Feeder -->
                <a href="/hanging-birdfeeder" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="outdoor garden 3dprinted"
                    >
                        <img
                            src="/assets/hanginig-feeder/thumbnail birdfeederGreen.png"
                            alt="Hanging Bird Feeder"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-outdoor">Outdoor</span>
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-garden">Garden</span>
                            </div>

                            <h3 class="text-xl font-bold text-gray-800 mb-2">
                                Hanging Bird Feeder
                            </h3>

                            <p class="text-gray-600 text-sm flex-1">
                                A simple and durable hanging bird feeder
                                designed for year-round outdoor use. Its
                                lightweight construction allows easy hanging
                                from trees, hooks or garden structures.
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Columpio -->
                <a href="/columpio" class="no-underline">
                    <div
                        class="project-card"
                        data-categories="home garden 3dprinted outdoor"
                    >
                        <img
                            src="/assets/columpio/columpio blue.png"
                            alt="Decorative columpio garden wall"
                        />

                        <div class="card-body">
                            <div class="mb-2">
                                <span class="tag tag-3dprinted">
                                    3D Printed
                                </span>
                                <span class="tag tag-home">Home</span>
                                <span class="tag tag-outdoor">Outdoor</span>
                            </div>
                            <span class="tag tag-garden">Garden</span>
                        </div>

                        <h3 class="text-xl font-bold text-gray-800 mb-2">
                            Decorative Columpio Wall
                        </h3>

                        <p class="text-gray-600 text-sm flex-1">
                            Decorative garden swing designed to hang from a
                            wall, adding a playful and charming touch to outdoor
                            spaces. Perfect for displaying small figures,
                            gnomes, or other decorations.
                        </p>
                    </div>
                </a>
            </div>

            <!-- No Results -->
            <div class="no-results" id="no-results">
                No projects in this category yet — check back soon.
            </div>
        </div>
    </section>

    <!-- Bottom Wave -->
    <svg
        viewBox="0 0 1439 147"
        version="1.1"
        xmlns="http://www.w3.org/2000/svg"
    >
        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
            <g transform="translate(-1.000000, -14.000000)" fill-rule="nonzero">
                <g fill="#1B2438">
                    <path
                        d="M1440,84 C1383.555,64.3 1342.555,51.3 1317,45 C1259.5,30.824 1206.707,25.526 1169,22 C1129.711,18.326 1044.426,18.475 980,22 C954.25,23.409 922.25,26.742 884,32 C845.122,37.787 818.455,42.121 804,45 C776.833,50.41 728.136,61.77 713,65 C660.023,76.309 621.544,87.729 584,94 C517.525,105.104 484.525,106.438 429,108 C379.49,106.484 342.823,104.484 319,102 C278.571,97.783 231.737,88.736 205,84 C154.629,75.076 86.296,57.743 0,32 L0,0 L1440,0 L1440,84 Z"
                    ></path>
                </g>

                <g transform="translate(1.000000, 15.000000)" fill="#FFFFFF">
                    <g
                        transform="translate(719.500000, 68.500000) rotate(-180.000000) translate(-719.500000, -68.500000)"
                    >
                        <path
                            d="M0,0 C90.7283404,0.927527913 147.912752,27.187927 291.910178,59.9119003 C387.908462,81.7278826 543.605069,89.334785 759,82.7326078 C469.336065,156.254352 216.336065,153.6679 0,74.9732496"
                            opacity="0.100000001"></path>

                        <path
                            d="M100,104.708498 C277.413333,72.2345949 426.147877,52.5246657 546.203633,45.5787101 C666.259389,38.6327546 810.524845,41.7979068 979,55.0741668 C931.069965,56.122511 810.303266,74.8455141 616.699903,111.243176 C423.096539,147.640838 250.863238,145.462612 100,104.708498 Z"
                            opacity="0.100000001"></path>

                        <path
                            d="M1046,51.6521276 C1130.83045,29.328812 1279.08318,17.607883 1439,40.1656806 L1439,120 C1271.17211,77.9435312 1140.17211,55.1609071 1046,51.6521276 Z"
                            opacity="0.200000003"></path>
                    </g>
                </g>
            </g>
        </g>
    </svg>

    <!-- CTA -->
    <section class="container mx-auto text-center py-6 mb-12">
        <h2
            class="w-full my-2 text-5xl font-bold leading-tight text-center text-gray-800"
        >
            Got an idea for a project?
        </h2>

        <div class="w-full mb-4">
            <div
                class="h-1 mx-auto bg-white w-1/6 opacity-25 my-0 py-0 rounded-t"
            >
            </div>
        </div>

        <h3 class="my-4 text-3xl leading-tight text-gray-600">
            Get in touch with
            <span style="color:#00d4ff;">K</span>acerys.
        </h3>

        <a href="/contact">
            <button
                class="mx-auto lg:mx-0 hover:underline bg-white text-gray-800 font-bold rounded-full my-6 py-4 px-8 shadow-lg focus:outline-none focus:shadow-outline transform transition hover:scale-105 duration-300 ease-in-out"
            >
                Contact -
                <span style="color:#00d4ff;">K</span>acerys
            </button>
        </a>
    </section>

    <!-- FILTER SCRIPT -->
    <script>
        var filterBtns = document.querySelectorAll(".filter-btn");
        var cardWrappers = document.querySelectorAll("#project-grid > a");
        var noResults = document.getElementById("no-results");
        var countEl = document.getElementById("project-count");

        function updateCount(visible) {
            countEl.textContent =
                visible + " project" + (visible !== 1 ? "s" : "");
        }

        filterBtns.forEach(function (btn) {
            btn.addEventListener("click", function () {
                var filter = btn.getAttribute("data-filter");

                filterBtns.forEach(function (b) {
                    b.classList.remove("active");
                });

                btn.classList.add("active");

                var visible = 0;

                cardWrappers.forEach(function (wrapper) {
                    var card = wrapper.querySelector(".project-card");

                    var cats = card.getAttribute("data-categories");

                    if (filter === "all" || cats.indexOf(filter) !== -1) {
                        wrapper.style.display = "";
                        visible++;
                    } else {
                        wrapper.style.display = "none";
                    }
                });

                noResults.style.display = visible === 0 ? "block" : "none";

                updateCount(visible);
            });
        });

        updateCount(cardWrappers.length);
    </script>
</Layout>

<Footer />
