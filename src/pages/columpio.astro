---
import ProductLayout from "../layouts/ProductLayout.astro";
---

<ProductLayout
    title="Miniature Hanging Garden Swing | Kacerys"
    productName="Miniature Hanging Garden Swing"
    price="Coming Soon"
>
    <!-- IMAGES -->
    <div slot="images">
        <img
            id="main-img"
            class="product-img-main"
            src="/assets/columpio/columpio negro.png"
            alt="Black miniature hanging garden swing"
        />

        <div class="thumb-grid">
            <img
                class="thumb"
                src="/assets/columpio/columpio blue.png"
                alt="Blue miniature hanging garden swing"
                onclick="swapImg(this)"
            />

            <img
                class="thumb"
                src="/assets/columpio/columpio wall.png"
                alt="Miniature hanging garden swing displayed on a wall"
                onclick="swapImg(this)"
            />

            <img
                class="thumb"
                src="/assets/columpio/columpio negro.png"
                alt="Black miniature hanging garden swing"
                onclick="swapImg(this)"
            />

            <img
                class="thumb active"
                src="/assets/columpio/thumbnail columpio.png"
                alt="Miniature hanging garden swing colour options"
                onclick="swapImg(this)"
            />
        </div>
    </div>

    <!-- TAGS -->
    <div slot="tags">
        <span class="tag tag-home">Home</span>
        <span class="tag tag-3dprinted">3D Printed</span>
        <span class="tag tag-garden">Garden</span>
        <span class="tag tag-outdoor">Outdoor</span>
    </div>

    <!-- DETAILS -->
    <div slot="details" class="flex flex-col gap-6">
        <p class="text-gray-400 text-sm">Custom colours available</p>

        <p class="text-gray-300 leading-relaxed">
            This decorative miniature garden swing is designed to bring a
            playful and charming detail to gardens, patios, balconies and
            outdoor spaces. Inspired by a traditional wooden porch swing, the
            design features a slatted seat, supportive armrests and decorative
            detailing that gives the piece plenty of character despite its
            compact size.
        </p>

        <p class="text-gray-300 leading-relaxed">
            The swing is 3D printed as a decorative miniature and can be
            suspended using cord or rope. Its lightweight design makes it
            particularly suitable for hanging against a garden wall, fence,
            wooden panel or other decorative outdoor display.
        </p>

        <p class="text-gray-300 leading-relaxed">
            It can also be incorporated into fairy gardens, miniature displays
            or plant arrangements, and can be produced in different colours to
            complement the surrounding space.
        </p>

        <!-- COLOURS -->
        <div class="product-card">
            <p class="section-title">Available Colours</p>

            <p class="text-gray-400 text-sm mb-4">
                Printed in PLA. Available in multiple colours.
            </p>

            <div>
                <div class="colour-swatch">
                    <span
                        class="swatch-dot"
                        style="background:#f5f7fa; border:1px solid #444;"
                    ></span>
                    White
                </div>

                <div class="colour-swatch">
                    <span class="swatch-dot" style="background:#212121;"></span>
                    Black
                </div>

                <div class="colour-swatch">
                    <span class="swatch-dot" style="background:#2196f3;"></span>
                    Blue
                </div>

                <div class="colour-swatch">
                    <span class="swatch-dot" style="background:#f44336;"></span>
                    Red
                </div>

                <div class="colour-swatch">
                    <span class="swatch-dot" style="background:#9c27b0;"></span>
                    Purple
                </div>

                <div class="colour-swatch">
                    <span class="swatch-dot" style="background:#ff9800;"></span>
                    Orange
                </div>
            </div>

            <p class="text-gray-500 text-xs mt-3">
                Colour availability may vary. Contact us if you need a specific
                colour.
            </p>
        </div>

        <!-- SPECIFICATIONS -->
        <div class="product-card">
            <p class="section-title">Specifications</p>

            <div class="spec-row">
                <span class="spec-label">Material</span>
                <span class="spec-value">PLA</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Dimensions</span>
                <span class="spec-value">150 × 50 × 125 mm</span>
            </div>

            <div class="spec-row">
                <span class="spec-label">Use</span>
                <span class="spec-value">Decorative</span>
            </div>
        </div>

        <!-- BUY -->
        <button class="buy-btn-disabled" disabled>
            Buy on Etsy — Coming Soon
        </button>

        <a
            href="/contact"
            style="color:#00D4FF; font-size:0.85rem; text-align:center; text-decoration:none;"
        >
            Need a specific colour or custom size?
            <strong>Get in touch →</strong>
        </a>
    </div>

    <!-- BOTTOM -->
    <div slot="bottom" class="mt-12 flex flex-wrap gap-10 justify-center">
        <!-- DESIGN FEATURES -->
        <div class="w-full md:w-1/2">
            <p class="section-title">Design Features</p>

            <div class="text-gray-300 leading-relaxed flex flex-col gap-4">
                <ul
                    class="flex flex-col gap-2"
                    style="list-style:none; padding:0;"
                >
                    <li>✓ Miniature traditional garden swing design</li>
                    <li>✓ Decorative slatted seat and backrest</li>
                    <li>✓ Designed to hang using cord or rope</li>
                    <li>✓ Suitable for walls, fences and garden displays</li>
                    <li>✓ Available in a variety of colours</li>
                    <li>
                        ✓ Ideal for fairy gardens and miniature outdoor scenes
                    </li>
                </ul>

                <div>
                    <p class="section-title mt-6">Project Skills</p>

                    <p>
                        3D Modelling · FDM 3D Printing · Prototyping · Design
                        for Manufacturing · Dimensional Tolerances · Decorative
                        Product Design
                    </p>
                </div>
            </div>
        </div>

        <!-- MATERIALS -->
        <div class="w-full md:w-5/12">
            <p class="section-title">Materials & Components</p>

            <ul
                class="text-gray-300 flex flex-col gap-2"
                style="list-style:none; padding:0;"
            >
                <li>✓ PLA 3D printed swing</li>
                <li>✓ Hanging cord or rope</li>
            </ul>

            <div style="margin-top: 2rem;">
                <p class="section-title">Shipping</p>

                <p class="text-gray-300 text-sm leading-relaxed">
                    Ships within 3–5 business days. Tracked delivery available.
                    Currently shipping to Ireland and UK.
                </p>
            </div>
        </div>
    </div>

    <!-- IMAGE GALLERY -->
    <script is:inline>
        function swapImg(thumb) {
            document.getElementById("main-img").src = thumb.src;

            document.querySelectorAll(".thumb").forEach(function (t) {
                t.classList.remove("active");
            });

            thumb.classList.add("active");
        }
    </script>
</ProductLayout>
