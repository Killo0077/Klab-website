---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="FAQ | Kacerys">
    <Header />

    <!-- FAQ Section -->
    <section class="pt-24 pb-12" style="background-color: #14213D;">
        <div class="container max-w-3xl mx-auto px-6">
            <!-- Products -->
            <div class="faq-card">
                <p class="category-title">Products</p>

                <div class="faq-item">
                    <button class="faq-question">
                        What material are your products printed in?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Most Kacerys products are printed in PETG or PLA+. PETG
                        is used for outdoor and functional parts because it is
                        more heat and weather resistant. PLA+ is used for indoor
                        products where a cleaner finish is the priority. The
                        material used is listed on each product page.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        Can I request a custom colour?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Yes — custom colour requests are welcome. Get in touch
                        via the
                        <a href="contact.html" style="color:#00D4FF;"
                            >contact page</a
                        > before placing your order and we will confirm availability.
                        Custom colours may add 1–2 days to the production time.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        Can I request a custom size or modified design?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Absolutely. Custom sizing and design modifications are
                        part of what Kacerys does. Describe what you need on the <a
                            href="contact.html"
                            style="color:#00D4FF;">contact page</a
                        >
                        and we will get back to you within 48 hours with options and
                        pricing.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        Are the products durable enough for outdoor use?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Products designed for outdoor use — such as the Bird
                        Feeder — are printed in PETG which handles rain, UV
                        exposure, and temperature changes well. They are not
                        designed for permanent submersion in water. Each product
                        page specifies whether it is suitable for outdoor use.
                    </div>
                </div>
            </div>

            <!-- Orders & Shipping -->
            <div class="faq-card">
                <p class="category-title">Orders & Shipping</p>

                <div class="faq-item">
                    <button class="faq-question">
                        Where do you ship to?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Currently Kacerys ships to Ireland and the United
                        Kingdom. If you are based elsewhere, get in touch and we
                        will do our best to arrange delivery.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        How long does delivery take?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Orders are printed and dispatched within 3–5 business
                        days. Delivery after dispatch is typically 2–4 business
                        days for Ireland and 3–6 business days for the UK.
                        Tracked shipping is available at checkout.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        How much does shipping cost?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Shipping costs are calculated at checkout based on your
                        location and order size. Free shipping may be available
                        on orders over a certain amount — check the product
                        listing for current offers.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        Can I track my order?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Yes. Once your order is dispatched you will receive a
                        tracking number by email so you can follow your parcel
                        every step of the way.
                    </div>
                </div>
            </div>

            <!-- Returns -->
            <div class="faq-card">
                <p class="category-title">Returns & Issues</p>

                <div class="faq-item">
                    <button class="faq-question">
                        What if my order arrives damaged?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        If your order arrives damaged, take a photo and contact
                        us at
                        <a
                            href="mailto:contact.kacerys@gmail.com"
                            style="color:#00D4FF;">contact.kacerys@gmail.com</a
                        >
                        within 7 days of delivery. We will arrange a replacement or
                        refund as quickly as possible.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        Do you accept returns?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Because each product is printed to order, we do not
                        accept returns for change of mind. However if there is a
                        fault with your product we will always make it right.
                        Custom orders are non-refundable once production has
                        started.
                    </div>
                </div>
            </div>

            <!-- Contact -->
            <div class="faq-card">
                <p class="category-title">Contact</p>

                <div class="faq-item">
                    <button class="faq-question">
                        How do I get in touch?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        You can reach Kacerys by email at
                        <a
                            href="mailto:contact.kacerys@gmail.com"
                            style="color:#00D4FF;">contact.kacerys@gmail.com</a
                        >
                        or via the <a href="contact.html" style="color:#00D4FF;"
                            >contact page</a
                        >. We usually respond within 24–48 hours.
                    </div>
                </div>

                <div class="faq-item">
                    <button class="faq-question">
                        I have a question that isn't answered here — what do I
                        do?
                        <span class="faq-icon">+</span>
                    </button>
                    <div class="faq-answer">
                        Just reach out directly. Send a message via the
                        <a href="contact.html" style="color:#00D4FF;"
                            >contact page</a
                        > and we will get back to you as soon as possible.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Wave back to dark -->
    <svg
        viewBox="0 0 1439 147"
        version="1.1"
        xmlns="http://www.w3.org/2000/svg"
    >
        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
            <g transform="translate(-1.000000, -14.000000)" fill-rule="nonzero">
                <g fill="#1B2745">
                    <path
                        d="M1440,84 C1383.555,64.3 1342.555,51.3 1317,45 C1259.5,30.824 1206.707,25.526 1169,22 C1129.711,18.326 1044.426,18.475 980,22 C954.25,23.409 922.25,26.742 884,32 C845.122,37.787 818.455,42.121 804,45 C776.833,50.41 728.136,61.77 713,65 C660.023,76.309 621.544,87.729 584,94 C517.525,105.104 484.525,106.438 429,108 C379.49,106.484 342.823,104.484 319,102 C278.571,97.783 231.737,88.736 205,84 C154.629,75.076 86.296,57.743 0,32 L0,0 L1440,0 L1440,84 Z"
                    >
                    </path>
                </g>
                <g transform="translate(1.000000, 15.000000)" fill="#FFFFFF">
                    <g
                        transform="translate(719.500000, 68.500000) rotate(-180.000000) translate(-719.500000, -68.500000)"
                    >
                        <path
                            d="M0,0 C90.7283404,0.927527913 147.912752,27.187927 291.910178,59.9119003 C387.908462,81.7278826 543.605069,89.334785 759,82.7326078 C469.336065,156.254352 216.336065,153.6679 0,74.9732496"
                            opacity="0.100000001"></path>
                        <path
                            d="M100,104.708498 C277.413333,72.2345949 426.147877,52.5246657 546.203633,45.5787101 C666.259389,38.6327546 810.524845,41.7979068 979,55.0741668 C931.069965,56.122511 810.303266,74.8455141 616.699903,111.243176 C423.096539,147.640838 250.863238,145.462612 100,104.708498 Z"
                            opacity="0.100000001"></path>
                        <path
                            d="M1046,51.6521276 C1130.83045,29.328812 1279.08318,17.607883 1439,40.1656806 L1439,120 C1271.17211,77.9435312 1140.17211,55.1609071 1046,51.6521276 Z"
                            opacity="0.200000003"></path>
                    </g>
                </g>
            </g>
        </g>
    </svg>

    <!-- CTA -->
    <section class="container mx-auto text-center py-6 mb-12">
        <h2
            class="w-full my-2 text-4xl font-bold leading-tight text-center text-white"
        >
            Still have a question?
        </h2>
        <div class="w-full mb-4">
            <div
                class="h-1 mx-auto bg-white w-1/6 opacity-25 my-0 py-0 rounded-t"
            >
            </div>
        </div>
        <h3 class="my-4 text-xl leading-tight text-gray-300">
            We're happy to help — get in touch directly.
        </h3>
        <a
            href="contact.html"
            style="position: relative; z-index: 10;"
            class="inline-block mx-auto hover:underline bg-white text-gray-800 font-bold rounded-full my-6 py-4 px-8 shadow-lg focus:outline-none transform transition hover:scale-105 duration-300 ease-in-out"
        >
            Contact Kacerys
        </a>
    </section>

    <Footer />
    <script>
        document.querySelectorAll(".faq-question").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var item = btn.closest(".faq-item");
                var isOpen = item.classList.contains("open");

                document.querySelectorAll(".faq-item").forEach(function (i) {
                    i.classList.remove("open");
                });

                if (!isOpen) {
                    item.classList.add("open");
                }
            });
        });
    </script>
</Layout>
