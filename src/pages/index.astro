---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { projectImage, CARD_SIZES } from "../utils/projectImage";

const projects = await getCollection("projects");
const featuredUrls = ["/bonsaiPot/", "/columpio/", "/birdfeeder/", "/remote-wall-mount/"];
const featured = projects.filter(p => featuredUrls.includes(p.data.url))
  .sort((a, b) => featuredUrls.indexOf(a.data.url) - featuredUrls.indexOf(b.data.url));
---
<Layout title="Kacerys | Practical Ideas. Real Solutions.">
  <Header />
  <main class="kac-home">
    <section class="kac-hero" aria-labelledby="home-title">
      <div class="kac-hero-art" aria-hidden="true"></div>
      <div class="kac-hero-shade" aria-hidden="true"></div>
      <div class="kac-wrap kac-hero-inner">
        <div class="kac-hero-copy">
          <p class="kac-eyebrow">Ideas <span>/</span> Designs <span>/</span> Solutions</p>
          <h1 id="home-title">Practical ideas.<br /><em>Real solutions.</em></h1>
          <p class="kac-hero-description">3D printed designs, garden projects, home accessories and practical solutions for everyday life. Small ideas, carefully made.</p>
          <div class="kac-hero-actions">
            <a class="kac-button-primary" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
            <a class="kac-button-outline" href="/about">About Kacerys</a>
          </div>
          <p class="kac-hero-footnote"><span aria-hidden="true">✦</span> Designed with purpose · Made in Ireland</p>
        </div>
      </div>
      <svg class="kac-section-wave hero-wave" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40C175 -27 326 90 531 75C726 60 832 6 1046 47C1190 74 1320 5 1440 45V100H0Z" fill="#071623"/><path d="M0 40C175 -27 326 90 531 75C726 60 832 6 1046 47C1190 74 1320 5 1440 45" fill="none" stroke="#1189ba" stroke-width="1.5"/></svg>
    </section>

    <section class="kac-featured kac-wrap" aria-labelledby="featured-heading">
      <div class="kac-section-heading">
        <div><p class="kac-eyebrow">Featured projects</p><h2 id="featured-heading">Popular projects<span class="kac-dot">.</span></h2></div>
        <div class="kac-section-right"><p>From garden favourites to everyday accessories — discover the projects we've brought to life.</p><a href="/projects" class="kac-text-link">View all projects <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="kac-featured-grid">
        {featured.map(project => (
          <a href={project.data.url} class="kac-feature-card" aria-label={`View ${project.data.title}`}>
            <div class="kac-feature-photo"><img src={projectImage(project.data.image, project.data.imageWidth, project.data.imageHeight).src} srcset={projectImage(project.data.image, project.data.imageWidth, project.data.imageHeight).srcset} sizes={projectImage(project.data.image, project.data.imageWidth, project.data.imageHeight).srcset ? CARD_SIZES : undefined} width={project.data.imageWidth} height={project.data.imageHeight} alt={project.data.title} loading="lazy" decoding="async" /></div>
            <div class="kac-feature-details">
              <span class="kac-feature-category">{project.data.category[0]}</span>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <span class="kac-feature-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="kac-maker" aria-labelledby="maker-heading">
      <svg class="kac-section-wave maker-top-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 37C211 -27 388 79 603 46C826 13 1037 9 1220 31C1342 46 1395 15 1440 15V70H0Z" fill="#082238"/><path d="M0 37C211 -27 388 79 603 46C826 13 1037 9 1220 31C1342 46 1395 15 1440 15" fill="none" stroke="#106b99" stroke-width="1.2"/></svg>
      <div class="kac-wrap kac-maker-grid">
        <div class="kac-maker-art"><img src="/assets/kacerys-gnome-maker.webp" alt="Kacerys maker gnome" loading="lazy" /></div>
        <div class="kac-maker-text">
          <p class="kac-eyebrow">Maker at heart</p>
          <h2 id="maker-heading">Design. Print. Improve.</h2>
          <p>Kacerys brings functional ideas to life through practical 3D printing, prototyping and a little imagination. Every project is an opportunity to make something useful.</p>
          <a href="/about" class="kac-text-link">Meet Kacerys <span aria-hidden="true">→</span></a>
        </div>
        <div class="kac-maker-highlights" aria-label="What Kacerys makes">
          <a href="/projects?category=3dprinted"><span>⬡</span> 3D printed designs</a>
          <a href="/projects?category=home"><span>⌂</span> Home solutions</a>
          <a href="/projects?category=garden"><span>❀</span> Garden projects</a>
        </div>
      </div>
    </section>

    <section class="kac-final-cta kac-wrap">
      <div><p class="kac-eyebrow">Something in mind?</p><h2>Have an idea worth making?</h2><p>Get in touch to talk about a custom design or practical 3D-printed solution.</p></div>
      <a href="/contact" class="kac-button-outline">Let's talk <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <Footer />
</Layout>
