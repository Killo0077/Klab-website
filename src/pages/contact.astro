---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Contact | Kacerys">
    <Header />
    <!-- Hero -->
    <div
        style="position: relative; min-height: 520px; background-color: #0D1117; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden;"
    >
        <!-- Background image -->
        <img
            src="/assets/herocontact.png"
            alt="Kacerys contact workshop"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; opacity: 2.0;"
        />
        <!-- Dark blue overlay — heavier so form text stays readable -->
        <div
            style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,15,30,0.55) 0%, rgba(10,15,30,0.35) 45%, rgba(10,15,30,0.92) 100%);"
        >
        </div>
        <!-- Hero content -->
        <div style="position: relative; z-index: 1; padding: 8rem 1.5rem 4rem;">
            <p
                class="uppercase tracking-loose cyan-text brand-font text-sm mb-4"
            >
                <!--GET IN TOUCH-->
            </p>
            <!-- <h1 class="text-5xl font-bold leading-tight brand-font mb-4 text-white">
                Contact <span class="cyan-text">K</span>acerys
            </h1> -->
            <!-- <p class="text-xl text-gray-300 max-w-xl mx-auto">
                Have a project idea, need a custom design, or want to discuss 3D printing solutions?
            </p> -->
        </div>
    </div>

    <!-- Wave into dark section -->
    <div class="relative -mt-12 lg:-mt-24">
        <svg
            viewBox="0 0 1428 174"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
        >
            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                <g
                    transform="translate(-2.000000, 44.000000)"
                    fill="#14213D"
                    fill-rule="nonzero"
                >
                    <path
                        d="M0,0 C90.7283404,0.927527913 147.912752,27.187927 291.910178,59.9119003 C387.908462,81.7278826 543.605069,89.334785 759,82.7326078 C469.336065,156.254352 216.336065,153.6679 0,74.9732496"
                        opacity="0.100000001"></path>
                    <path
                        d="M100,104.708498 C277.413333,72.2345949 426.147877,52.5246657 546.203633,45.5787101 C666.259389,38.6327546 810.524845,41.7979068 979,55.0741668 C931.069965,56.122511 810.303266,74.8455141 616.699903,111.243176 C423.096539,147.640838 250.863238,145.462612 100,104.708498 Z"
                        opacity="0.100000001"></path>
                    <path
                        d="M1046,51.6521276 C1130.83045,29.328812 1279.08318,17.607883 1439,40.1656806 L1439,120 C1271.17211,77.9435312 1140.17211,55.1609071 1046,51.6521276 Z"
                        opacity="0.200000003"></path>
                </g>
                <g
                    transform="translate(-4.000000, 76.000000)"
                    fill="#14213D"
                    fill-rule="nonzero"
                >
                    <path
                        d="M0.457,34.035 C57.086,53.198 98.208,65.809 123.822,71.865 C181.454,85.495 234.295,90.29 272.033,93.459 C311.355,96.759 396.635,95.801 461.025,91.663 C486.76,90.01 518.727,86.372 556.926,80.752 C595.747,74.596 622.372,70.008 636.799,66.991 C663.913,61.324 712.501,49.503 727.605,46.128 C780.47,34.317 818.839,22.532 856.324,15.904 C922.689,4.169 955.676,2.522 1011.185,0.432 C1060.705,1.477 1097.39,3.129 1121.236,5.387 C1161.703,9.219 1208.621,17.821 1235.4,22.304 C1285.855,30.748 1354.351,47.432 1440.886,72.354 L1441.191,104.352 L1.121,104.031 L0.457,34.035 Z"
                    >
                    </path>
                </g>
            </g>
        </svg>
    </div>

    <!-- Contact Section -->
    <section class="py-12" style="background-color: #14213D;">
        <div class="container max-w-6xl mx-auto px-6">
            <div class="flex flex-wrap gap-8 justify-center">
                <!-- Contact Form -->
                <div class="contact-card w-full">
                    <h2 class="text-2xl font-bold brand-font mb-2 text-white">
                        Send a Message
                    </h2>
                    <p class="text-gray-400 text-sm mb-6">
                        Fill in the form and it will open your email client with
                        everything pre-filled.
                    </p>

                    <div class="flex flex-col gap-5">
                        <div>
                            <label class="form-label" for="contact-name"
                                >Your Name</label
                            >
                            <input
                                class="form-input"
                                type="text"
                                id="contact-name"
                                placeholder="John Smith"
                            />
                        </div>
                        <div>
                            <label class="form-label" for="contact-subject"
                                >Subject</label
                            >
                            <input
                                class="form-input"
                                type="text"
                                id="contact-subject"
                                placeholder="Custom bird feeder design"
                            />
                        </div>
                        <div>
                            <label class="form-label" for="contact-message"
                                >Message</label
                            >
                            <textarea
                                class="form-input"
                                id="contact-message"
                                placeholder="Tell me about your project idea or question..."
                            ></textarea>
                        </div>
                        <button class="submit-btn" onclick="sendEmail()"
                            >Send Message</button
                        >
                    </div>

                    <!-- Divider -->
                    <div
                        style="border-top: 1px solid rgba(0,212,255,0.1); margin: 2rem 0;"
                    >
                    </div>

                    <!-- Info blocks -->
                    <div class="flex flex-col gap-4">
                        <div class="info-block">
                            <div class="info-icon">
                                <svg
                                    width="18"
                                    height="18"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="#00D4FF"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p
                                    class="text-xs text-gray-400 uppercase font-bold tracking-widest mb-1"
                                >
                                    Email
                                </p>
                                <a
                                    href="mailto:contact.kacerys@gmail.com"
                                    class="text-white hover:text-cyan-400 transition-colors"
                                    style="color: #00D4FF;"
                                >
                                    contact.kacerys@gmail.com
                                </a>
                            </div>
                        </div>

                        <div class="info-block">
                            <div class="info-icon">
                                <svg
                                    width="18"
                                    height="18"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="#00D4FF"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p
                                    class="text-xs text-gray-400 uppercase font-bold tracking-widest mb-1"
                                >
                                    Response Time
                                </p>
                                <p class="text-white text-sm">
                                    Usually within 24–48 hours.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Wave back to dark -->
    <svg
        viewBox="0 0 1439 147"
        version="1.1"
        xmlns="http://www.w3.org/2000/svg"
    >
        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
            <g transform="translate(-1.000000, -14.000000)" fill-rule="nonzero">
                <g fill="#1B2745">
                    <path
                        d="M1440,84 C1383.555,64.3 1342.555,51.3 1317,45 C1259.5,30.824 1206.707,25.526 1169,22 C1129.711,18.326 1044.426,18.475 980,22 C954.25,23.409 922.25,26.742 884,32 C845.122,37.787 818.455,42.121 804,45 C776.833,50.41 728.136,61.77 713,65 C660.023,76.309 621.544,87.729 584,94 C517.525,105.104 484.525,106.438 429,108 C379.49,106.484 342.823,104.484 319,102 C278.571,97.783 231.737,88.736 205,84 C154.629,75.076 86.296,57.743 0,32 L0,0 L1440,0 L1440,84 Z"
                    >
                    </path>
                </g>
                <g transform="translate(1.000000, 15.000000)" fill="#FFFFFF">
                    <g
                        transform="translate(719.500000, 68.500000) rotate(-180.000000) translate(-719.500000, -68.500000)"
                    >
                        <path
                            d="M0,0 C90.7283404,0.927527913 147.912752,27.187927 291.910178,59.9119003 C387.908462,81.7278826 543.605069,89.334785 759,82.7326078 C469.336065,156.254352 216.336065,153.6679 0,74.9732496"
                            opacity="0.100000001"></path>
                        <path
                            d="M100,104.708498 C277.413333,72.2345949 426.147877,52.5246657 546.203633,45.5787101 C666.259389,38.6327546 810.524845,41.7979068 979,55.0741668 C931.069965,56.122511 810.303266,74.8455141 616.699903,111.243176 C423.096539,147.640838 250.863238,145.462612 100,104.708498 Z"
                            opacity="0.100000001"></path>
                        <path
                            d="M1046,51.6521276 C1130.83045,29.328812 1279.08318,17.607883 1439,40.1656806 L1439,120 C1271.17211,77.9435312 1140.17211,55.1609071 1046,51.6521276 Z"
                            opacity="0.200000003"></path>
                    </g>
                </g>
            </g>
        </g>
    </svg>

    <!-- Footer -->
    <Footer class="bg-white">
        <div class="container mx-auto px-8">
            <div class="w-full flex flex-col md:flex-row py-6">
                <div class="flex-1 mb-6 text-black">
                    <a
                        class="no-underline hover:no-underline font-bold text-2xl lg:text-4xl brand-font text-gray-900"
                        href="/"
                    >
                        <span style="color:#00d4ff;">K</span>acerys
                    </a>
                </div>
                <div class="flex-1">
                    <p class="uppercase text-gray-500 md:mb-6">Links</p>
                    <ul class="list-reset mb-6">
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/faq"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >FAQ</a
                            >
                        </li>
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/contact"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >Help</a
                            >
                        </li>
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/contact"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >Support</a
                            >
                        </li>
                    </ul>
                </div>
                <div class="flex-1">
                    <p class="uppercase text-gray-500 md:mb-6">Legal</p>
                    <ul class="list-reset mb-6">
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/contact"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >Terms</a
                            >
                        </li>
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/contact"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >Privacy</a
                            >
                        </li>
                    </ul>
                </div>

                <div class="flex-1">
                    <p class="uppercase text-gray-500 md:mb-6">Company</p>
                    <ul class="list-reset mb-6">
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/about"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >About Us</a
                            >
                        </li>
                        <li class="mt-2 inline-block mr-2 md:block md:mr-0">
                            <a
                                href="/contact"
                                class="no-underline hover:underline text-gray-800 hover:text-pink-500"
                                >Contact</a
                            >
                        </li>
                    </ul>
                </div>
            </div>
            <div class="text-center pb-4">
                <p class="text-gray-400 text-sm">
                    © 2026 Kacerys. All rights reserved.
                </p>
            </div>
        </div>
    </Footer>
    <script is:inline>
        function sendEmail() {
            var name = document.getElementById("contact-name").value.trim();
            var subject = document
                .getElementById("contact-subject")
                .value.trim();
            var message = document
                .getElementById("contact-message")
                .value.trim();

            if (!name && !message) {
                alert("Please fill in at least your name and message.");
                return;
            }

            var body = "Hi Kacerys,\n\n" + message + "\n\nFrom: " + name;

            var mailtoLink =
                "mailto:contact.kacerys@gmail.com" +
                "?subject=" +
                encodeURIComponent(subject || "Enquiry from kacerys.com") +
                "&body=" +
                encodeURIComponent(body);

            window.location.href = mailtoLink;
        }
    </script>
</Layout>
